# /etc/cron.d/telaio-backup — backup quotidiano con copia offsite e verifica settimanale.
# Girano come utente deploy (gruppo docker). Prima: sudo install -m 640 -o deploy -g deploy /dev/null /var/log/telaio-backup.log
# Installa con:  sudo cp deploy/cron/telaio-backup /etc/cron.d/telaio-backup
# (il file si chiama senza estensione: cron ignora i nomi con il punto)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Ogni notte alle 03:30 (il job interno del worker fa la sua copia locale alle 02:30).
30 3 * * * deploy /opt/telaio/deploy/backup.sh >> /var/log/telaio-backup.log 2>&1
# Ogni domenica alle 05:00 prova a ripristinare l'ultimo backup in un database temporaneo.
0 5 * * 0 deploy /opt/telaio/deploy/restore.sh --verifica "$(ls -1t /var/backups/telaio/telaio-*.dump | head -1)" >> /var/log/telaio-backup.log 2>&1
