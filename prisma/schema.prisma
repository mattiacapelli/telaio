generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- anagrafica

/// Cliente. L'anagrafica è di sola lettura in Telaio: la fonte di verità è
/// Twenty (vedi twentyId / syncedAt), come indicato nella schermata Clienti.
model Cliente {
  id               String    @id @default(cuid())
  twentyId         String?   @unique
  ragioneSociale   String
  sigla            String // iniziali mostrate nell'avatar, es. "VB"
  settore          String? // Manifattura, Trasporti, Servizi, Software, Retail, Sanità
  citta            String?
  partitaIva       String?
  codiceFiscale    String?
  pec              String?
  codiceSdi        String?
  tariffaOraria    Decimal   @db.Decimal(10, 2)
  terminiPagamento Int       @default(30) // giorni data fattura
  statoRelazione   String    @default("CUSTOMER")
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Cestino: un cliente eliminato non compare più nelle liste, ma resta
  /// recuperabile finché non lo si elimina definitivamente dal cestino.
  eliminataIl      DateTime?

  referenti  Referente[]
  preventivi Preventivo[]
  progetti   Progetto[]
  ticket     Ticket[]
  fatture    Fattura[]
  contratti  Contratto[]

  @@index([ragioneSociale])
  @@index([eliminataIl])
}

model Referente {
  id         String       @id @default(cuid())
  twentyId   String?      @unique
  clienteId  String
  nome       String
  cognome    String
  ruolo      String?
  email      String?
  telefono   String?
  principale Boolean      @default(false)
  cliente    Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  preventivi Preventivo[]

  @@index([clienteId])
}

// ---------------------------------------------------------------- commerciale

enum StatoPreventivo {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

/// Il preventivo è il "contenitore": porta numero, cliente e stato, mentre il
/// contenuto economico vive nelle revisioni. `revisioneCorrente` indica quella
/// da mostrare; le precedenti restano leggibili e non si modificano più.
model Preventivo {
  id         String          @id @default(cuid())
  numero     String          @unique // PRE-2026/021
  titolo     String
  clienteId  String
  stato      StatoPreventivo @default(BOZZA)
  imponibile Decimal         @db.Decimal(12, 2)
  inviatoIl  DateTime?
  scadeIl    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  /// Referente a cui è indirizzata l'offerta.
  referenteId       String?
  /// Sconto percentuale sul totale, applicato dopo gli sconti di riga.
  scontoPercento    Decimal   @default(0) @db.Decimal(5, 2)
  /// Aliquota IVA del documento.
  aliquotaIva       Decimal   @default(22) @db.Decimal(5, 2)
  /// Probabilità di chiusura, per pesare il valore in trattativa.
  probabilita       Int?
  /// Testi del documento.
  premessa          String?
  tempiConsegna     String?
  modalitaPagamento String?
  validitaGiorni    Int?
  note              String?
  eliminataIl       DateTime?

  cliente           Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  referente         Referente?            @relation(fields: [referenteId], references: [id], onDelete: SetNull)
  modelloPdf        ModelloPdf?           @relation(fields: [modelloPdfId], references: [id], onDelete: SetNull)
  modelloPdfId      String?
  /// Ragione sociale emittente; senza scelta esplicita si usa la predefinita.
  azienda           Azienda?              @relation(fields: [aziendaId], references: [id], onDelete: SetNull)
  aziendaId         String?
  voci              VocePreventivo[]
  progetto          Progetto?
  revisioni         RevisionePreventivo[]
  revisioneCorrente Int                   @default(1)
  /// Motivo dell'ultima modifica: viene trasferito alla revisione quando
  /// questa versione verrà a sua volta congelata.
  motivoCorrente    String?

  @@index([stato])
  @@index([eliminataIl])
}

/// Copia congelata del preventivo a un dato momento.
///
/// Le voci sono duplicate qui, non referenziate: una revisione deve poter
/// essere riletta esattamente com'era, anche se il preventivo cambia dopo.
model RevisionePreventivo {
  id           String    @id @default(cuid())
  preventivoId String
  numero       Int // 1, 2, 3… → mostrato come "r2", "r3"
  titolo       String
  imponibile   Decimal   @db.Decimal(12, 2)
  scadeIl      DateTime?
  /// Perché è stata creata questa revisione (es. "sconto concordato").
  motivo       String?
  /// Copia delle voci al momento del congelamento.
  voci         Json
  /// Chi l'ha creata: l'email basta, e sopravvive alla cancellazione dell'utente.
  autore       String?
  creataIl     DateTime  @default(now())

  preventivo Preventivo @relation(fields: [preventivoId], references: [id], onDelete: Cascade)

  @@unique([preventivoId, numero])
  @@index([preventivoId])
}

enum UnitaMisura {
  ORE
  GIORNI
  CORPO
  PEZZI
}

model VocePreventivo {
  id           String      @id @default(cuid())
  preventivoId String
  descrizione  String
  /// Dettaglio facoltativo mostrato sotto la descrizione.
  nota         String?
  quantita     Decimal     @db.Decimal(10, 2)
  unita        UnitaMisura @default(ORE)
  prezzo       Decimal     @db.Decimal(10, 2)
  /// Sconto percentuale sulla singola riga.
  sconto       Decimal     @default(0) @db.Decimal(5, 2)
  ordine       Int         @default(0)
  preventivo   Preventivo  @relation(fields: [preventivoId], references: [id], onDelete: Cascade)

  @@index([preventivoId])
}

// ---------------------------------------------------------------- delivery

enum StatoProgetto {
  DA_AVVIARE
  IN_CORSO
  IN_PAUSA
  CONCLUSO
}

model Progetto {
  id           String        @id @default(cuid())
  nome         String
  clienteId    String
  preventivoId String?       @unique
  stato        StatoProgetto @default(DA_AVVIARE)
  valore       Decimal       @db.Decimal(12, 2)
  budgetOre    Decimal       @db.Decimal(10, 2)
  inizioIl     DateTime?
  consegnaIl   DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  cliente       Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  preventivo    Preventivo?        @relation(fields: [preventivoId], references: [id])
  attivita      Attivita[]
  ticket        Ticket[]
  registrazioni RegistrazioneOre[]
  costi         Costo[]
  milestone     Milestone[]
  documenti     Documento[]
  noteProgetto  NotaProgetto[]
  contratti     Contratto[]
  problemi      Problema[]
  eventi        EventoProgetto[]

  /// Repository GitHub collegata, nel formato `owner/repo`. Facoltativa.
  repoGithub   String?
  /// Branch da seguire per l'avanzamento; se vuoto si usa quello predefinito.
  branchGithub String?
  eliminataIl  DateTime?

  @@index([stato])
  @@index([eliminataIl])
}

enum GravitaProblema {
  BASSA
  MEDIA
  ALTA
  CRITICA
}

enum StatoProblema {
  APERTO
  IN_GESTIONE
  RISOLTO
  ACCETTATO
}

/// Criticità, rischio o errore emerso durante il progetto.
///
/// Separato dai ticket: quelli arrivano dal cliente ad assistenza avviata,
/// questi riguardano l'andamento del lavoro (ritardi, blocchi, scelte
/// tecniche sbagliate) e vanno visti dal team, non dal cliente.
model Problema {
  id          String          @id @default(cuid())
  progettoId  String
  titolo      String
  descrizione String?
  gravita     GravitaProblema @default(MEDIA)
  stato       StatoProblema   @default(APERTO)
  /// Che cosa si è deciso di fare: compilato alla chiusura.
  risoluzione String?
  /// Impatto stimato in ore, per capire quanto costa davvero.
  impattoOre  Decimal?        @db.Decimal(10, 2)
  segnalatoDa String?
  apertoIl    DateTime        @default(now())
  risoltoIl   DateTime?

  progetto Progetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)

  @@index([progettoId])
  @@index([stato])
}

/// Nota su un'attività o un ticket.
model NotaOperativa {
  id         String   @id @default(cuid())
  attivitaId String?
  ticketId   String?
  testo      String
  autore     String?
  createdAt  DateTime @default(now())

  attivita Attivita? @relation(fields: [attivitaId], references: [id], onDelete: Cascade)
  ticket   Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([attivitaId])
  @@index([ticketId])
}

/// Voce del diario di progetto: tutto ciò che è successo, in ordine di tempo.
///
/// Gli eventi vengono registrati dal codice quando accade qualcosa di
/// rilevante (cambio stato, milestone completata, fattura emessa…), così la
/// cronologia resta leggibile anche a distanza di mesi.
model EventoProgetto {
  id         String   @id @default(cuid())
  progettoId String
  /// Categoria dell'evento: guida icona e colore nella timeline.
  tipo       String
  testo      String
  /// Dettaglio facoltativo (valore precedente, importo, numero fattura…).
  dettaglio  String?
  autore     String?
  createdAt  DateTime @default(now())

  progetto Progetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)

  @@index([progettoId, createdAt])
}

/// File allegato a un progetto (contratti, capitolati, verbali…).
/// Il binario sta su S3/MinIO: qui restano solo i metadati e la chiave.
model Documento {
  id          String    @id @default(cuid())
  progettoId  String?
  ticketId    String?
  contrattoId String?
  nome        String
  chiave      String    @unique // percorso dell'oggetto su S3
  tipo        String // MIME
  dimensione  Int // byte
  caricatoDa  String?
  createdAt   DateTime  @default(now())
  eliminataIl DateTime?

  progetto  Progetto?  @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  ticket    Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contratto Contratto? @relation(fields: [contrattoId], references: [id], onDelete: Cascade)

  @@index([progettoId])
  @@index([ticketId])
  @@index([contrattoId])
  @@index([eliminataIl])
}

/// Annotazione libera sul progetto: decisioni prese, promesse fatte al
/// cliente, cose che non stanno in un'attività.
model NotaProgetto {
  id         String   @id @default(cuid())
  progettoId String
  testo      String
  autore     String?
  createdAt  DateTime @default(now())

  progetto Progetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)

  @@index([progettoId])
}

model Milestone {
  id         String    @id @default(cuid())
  progettoId String
  titolo     String
  scadenzaIl DateTime?
  completata Boolean   @default(false)
  progetto   Progetto  @relation(fields: [progettoId], references: [id], onDelete: Cascade)

  @@index([progettoId])
}

enum StatoAttivita {
  DA_FARE
  IN_CORSO
  BLOCCATA
  FATTA
}

model Attivita {
  id           String        @id @default(cuid())
  titolo       String
  progettoId   String?
  stato        StatoAttivita @default(DA_FARE)
  stimaOre     Decimal?      @db.Decimal(10, 2)
  scadenzaIl   DateTime?
  bloccoNota   String?
  completataIl DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  eliminataIl  DateTime?

  progetto      Progetto?          @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  registrazioni RegistrazioneOre[]
  costi         Costo[]
  note          NotaOperativa[]

  @@index([stato])
  @@index([progettoId])
  @@index([eliminataIl])
}

// ---------------------------------------------------------------- assistenza

enum StatoTicket {
  APERTO
  IN_LAVORAZIONE
  ATTESA_CLIENTE
  RISOLTO
  CHIUSO
}

enum PrioritaTicket {
  BASSA
  MEDIA
  ALTA
  URGENTE
}

model Ticket {
  id           String         @id @default(cuid())
  numero       Int            @unique // #128
  titolo       String
  descrizione  String?
  clienteId    String
  progettoId   String?
  stato        StatoTicket    @default(APERTO)
  priorita     PrioritaTicket @default(MEDIA)
  conContratto Boolean        @default(false)
  apertoIl     DateTime       @default(now())
  risoltoIl    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  eliminataIl  DateTime?

  cliente       Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  progetto      Progetto?          @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  registrazioni RegistrazioneOre[]
  costi         Costo[]
  note          NotaOperativa[]
  documenti     Documento[]
  /// Contratto che copre questo ticket, se ce n'è uno attivo.
  contrattoId   String?
  contratto     Contratto?         @relation(fields: [contrattoId], references: [id], onDelete: SetNull)

  @@index([stato])
  @@index([eliminataIl])
}

// ---------------------------------------------------------------- timesheet

model RegistrazioneOre {
  id            String    @id @default(cuid())
  data          DateTime  @db.Date
  ore           Decimal   @db.Decimal(6, 2)
  descrizione   String?
  fatturabile   Boolean   @default(true)
  progettoId    String?
  attivitaId    String?
  ticketId      String?
  rigaFatturaId String?
  createdAt     DateTime  @default(now())
  eliminataIl   DateTime?

  progetto    Progetto?    @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  attivita    Attivita?    @relation(fields: [attivitaId], references: [id], onDelete: SetNull)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  rigaFattura RigaFattura? @relation(fields: [rigaFatturaId], references: [id], onDelete: SetNull)

  @@index([data])
  @@index([progettoId])
  @@index([eliminataIl])
}

enum TipoCosto {
  TRASFERTA
  MATERIALE
  LICENZA
  SERVIZIO_TERZI
  ALTRO
}

enum ModalitaTrasferta {
  /// Chilometri per tariffa chilometrica.
  CHILOMETRICA
  /// Spese effettive documentate (pedaggi, carburante, parcheggi).
  PIE_DI_LISTA
  /// Cifra fissa per uscita.
  FORFETTARIA
}

/// Costo sostenuto durante il lavoro: trasferte, materiali, licenze.
///
/// Sta accanto alle ore, non dentro: il consuntivo di un ticket ha due
/// dimensioni indipendenti, il tempo e il denaro speso. Un modello unico
/// "intervento" che le raggruppasse duplicherebbe ciò che il ticket già è.
model Costo {
  id           String             @id @default(cuid())
  data         DateTime           @db.Date
  tipo         TipoCosto          @default(ALTRO)
  descrizione  String
  /// Importo totale del costo. Per le trasferte chilometriche è calcolato
  /// da quantita x tariffa, ma resta salvato: la tariffa può cambiare nel
  /// tempo e il costo già registrato non deve seguirla.
  importo      Decimal            @db.Decimal(10, 2)
  /// Chilometri o unità, quando il costo è calcolato.
  quantita     Decimal?           @db.Decimal(10, 2)
  tariffa      Decimal?           @db.Decimal(10, 2)
  modalita     ModalitaTrasferta?
  /// Se rifatturabile al cliente. Deciso caso per caso: il canone di un
  /// contratto copre il tempo, non sempre le spese vive.
  rimborsabile Boolean            @default(true)
  /// Ricevuta o giustificativo allegato.
  documentoId  String?

  progettoId    String?
  attivitaId    String?
  ticketId      String?
  rigaFatturaId String?
  registratoDa  String?
  createdAt     DateTime  @default(now())
  eliminataIl   DateTime?

  progetto    Progetto?    @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  attivita    Attivita?    @relation(fields: [attivitaId], references: [id], onDelete: SetNull)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  rigaFattura RigaFattura? @relation(fields: [rigaFatturaId], references: [id], onDelete: SetNull)

  @@index([data])
  @@index([ticketId])
  @@index([progettoId])
  @@index([eliminataIl])
}

// ---------------------------------------------------------------- denaro

enum StatoFattura {
  DA_EMETTERE
  EMESSA
  PAGATA
  SCADUTA
}

model Fattura {
  id          String       @id @default(cuid())
  numero      String       @unique // 2026/044
  clienteId   String
  stato       StatoFattura @default(DA_EMETTERE)
  imponibile  Decimal      @db.Decimal(12, 2)
  aliquotaIva Decimal      @default(22) @db.Decimal(5, 2)
  emessaIl    DateTime?
  scadeIl     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// Cestino: consentito solo per fatture DA_EMETTERE, mai per quelle già
  /// uscite dallo studio (obbligo fiscale di sequenzialità dei numeri).
  eliminataIl DateTime?

  cliente   Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Ragione sociale emittente; senza scelta esplicita si usa la predefinita.
  azienda   Azienda?      @relation(fields: [aziendaId], references: [id], onDelete: SetNull)
  aziendaId String?
  righe     RigaFattura[]
  incassi   Incasso[]

  @@index([stato])
  @@index([eliminataIl])
}

model RigaFattura {
  id          String  @id @default(cuid())
  fatturaId   String
  descrizione String
  quantita    Decimal @db.Decimal(10, 2)
  prezzo      Decimal @db.Decimal(10, 2)
  ordine      Int     @default(0)

  fattura       Fattura            @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  registrazioni RegistrazioneOre[]
  costi         Costo[]

  @@index([fatturaId])
}

enum MetodoPagamento {
  BONIFICO
  CARTA
  CONTANTI
  ALTRO
}

/// Un conto su cui arrivano gli incassi (banca, PayPal, cassa contanti...).
///
/// Prima era un campo di testo libero su ogni incasso: bastava una
/// battitura diversa per spaccare in due lo stesso conto nei riepiloghi.
/// Qui è un'anagrafica scelta da un menu, come Azienda per le ragioni
/// sociali.
model ContoIncasso {
  id          String    @id @default(cuid())
  nome        String
  note        String?
  predefinito Boolean   @default(false)
  ordine      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eliminataIl DateTime?

  incassi Incasso[]

  @@index([eliminataIl])
}

model Incasso {
  id        String          @id @default(cuid())
  fatturaId String
  data      DateTime        @db.Date
  importo   Decimal         @db.Decimal(12, 2)
  metodo    MetodoPagamento @default(BONIFICO)
  nota      String?
  createdAt DateTime        @default(now())

  fattura Fattura       @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  conto   ContoIncasso? @relation(fields: [contoId], references: [id], onDelete: SetNull)
  contoId String?

  @@index([data])
  @@index([contoId])
}

// ---------------------------------------------------------------- impostazioni

// --------------------------------------------------------------- contratti

enum TipoContratto {
  /// Monte ore periodico: i ticket del cliente lo consumano.
  ASSISTENZA_ORE
  /// Importo ricorrente senza monte ore (hosting, manutenzione).
  CANONE_FISSO
  /// Contratto che formalizza un progetto.
  PROGETTO
}

enum PeriodicitaContratto {
  MENSILE
  TRIMESTRALE
  SEMESTRALE
  ANNUALE
}

enum StatoContratto {
  BOZZA
  ATTIVO
  SOSPESO
  SCADUTO
  DISDETTO
}

/// Contratto con un cliente.
///
/// I tre tipi condividono la stessa tabella perché condividono il ciclo di
/// vita (date, rinnovo, canone) e differiscono solo per come si consumano:
/// `monteOre` vale per l'assistenza, `progettoId` per i contratti di progetto.
model Contratto {
  id                  String               @id @default(cuid())
  numero              String               @unique
  titolo              String
  clienteId           String
  progettoId          String?
  tipo                TipoContratto        @default(ASSISTENZA_ORE)
  stato               StatoContratto       @default(BOZZA)
  /// Importo del canone per periodo.
  canone              Decimal              @db.Decimal(12, 2)
  periodicita         PeriodicitaContratto @default(MENSILE)
  /// Ore incluse nel periodo (solo ASSISTENZA_ORE).
  monteOre            Decimal?             @db.Decimal(10, 2)
  /// Le ore eccedenti il monte si fatturano a questa tariffa; se nulla si usa
  /// quella del cliente.
  tariffaExtra        Decimal?             @db.Decimal(10, 2)
  inizioIl            DateTime
  scadeIl             DateTime?
  /// Rinnovo tacito alla scadenza.
  rinnovoAutomatico   Boolean              @default(false)
  /// Preavviso di disdetta, in giorni.
  preavvisoGiorni     Int                  @default(30)
  /// Testi del documento, copiati dai modelli alla creazione.
  premessa            String?
  oggetto             String?
  condizioniPagamento String?
  condizioniServizio  String?
  note                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  eliminataIl         DateTime?

  cliente      Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  progetto     Progetto?          @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  modelloPdf   ModelloPdf?        @relation(fields: [modelloPdfId], references: [id], onDelete: SetNull)
  modelloPdfId String?
  /// Ragione sociale emittente; senza scelta esplicita si usa la predefinita.
  azienda      Azienda?           @relation(fields: [aziendaId], references: [id], onDelete: SetNull)
  aziendaId    String?
  periodi      PeriodoContratto[]
  documenti    Documento[]
  ticket       Ticket[]

  @@index([clienteId])
  @@index([stato])
  @@index([eliminataIl])
}

/// Periodo di competenza di un contratto: è qui che si misura il consumo del
/// monte ore e si tiene traccia della fattura del canone.
model PeriodoContratto {
  id          String   @id @default(cuid())
  contrattoId String
  inizioIl    DateTime @db.Date
  fineIl      DateTime @db.Date
  /// Ore incluse in questo periodo, copiate dal contratto alla creazione:
  /// se il contratto cambia, i periodi già chiusi restano quelli concordati.
  monteOre    Decimal? @db.Decimal(10, 2)
  fatturaId   String?
  createdAt   DateTime @default(now())

  contratto Contratto @relation(fields: [contrattoId], references: [id], onDelete: Cascade)

  @@unique([contrattoId, inizioIl])
  @@index([contrattoId])
}

// ---------------------------------------------------------------- workflow

enum TipoInnesco {
  EVENTO
  PIANIFICATO
  MANUALE
}

/// Automazione configurabile a blocchi.
///
/// I blocchi (condizioni e azioni) sono salvati come JSON: la loro forma
/// cambia col tipo di blocco, e un modello relazionale per ogni variante
/// renderebbe rigido qualcosa che deve restare estendibile.
model Workflow {
  id               String      @id @default(cuid())
  nome             String
  descrizione      String?
  attivo           Boolean     @default(true)
  innesco          TipoInnesco @default(EVENTO)
  /// Per EVENTO: nome dell'evento (es. "preventivo.accettato").
  /// Per PIANIFICATO: espressione di frequenza (es. "giornaliero").
  eventoChiave     String?
  /// Blocchi condizione: tutte devono essere vere perché il workflow proceda.
  condizioni       Json        @default("[]")
  /// Blocchi azione, eseguiti in ordine.
  azioni           Json        @default("[]")
  /// Statistiche d'uso, utili per capire se un workflow serve davvero.
  esecuzioni       Int         @default(0)
  ultimaEsecuzione DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  eliminataIl      DateTime?

  registri RegistroWorkflow[]

  @@index([innesco, attivo])
  @@index([eliminataIl])
}

/// Esito di una singola esecuzione: serve a capire perché un workflow non ha
/// fatto quello che ci si aspettava.
model RegistroWorkflow {
  id         String   @id @default(cuid())
  workflowId String
  /// true se tutte le azioni sono andate a buon fine.
  successo   Boolean
  /// Perché si è fermato, o cosa ha fatto.
  esito      String
  /// Contesto dell'esecuzione (entità coinvolta, valori valutati).
  dettaglio  Json?
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
}

/// Notifica interna generata da un workflow o dal sistema.
model Notifica {
  id        String    @id @default(cuid())
  titolo    String
  testo     String?
  /// Collegamento facoltativo alla pagina pertinente.
  link      String?
  livello   String    @default("info")
  lettaIl   DateTime?
  createdAt DateTime  @default(now())

  @@index([lettaIl, createdAt])
}

/// Modello di stampa: quali blocchi compongono il PDF e in che ordine.
///
/// I blocchi sono salvati come JSON perché la loro configurazione cambia col
/// tipo — l'intestazione ha il logo, la tabella voci ha le colonne — e un
/// modello relazionale per ogni variante renderebbe rigido qualcosa che deve
/// poter crescere.
model ModelloPdf {
  id          String    @id @default(cuid())
  nome        String
  /// PREVENTIVO o CONTRATTO: determina quali blocchi sono disponibili.
  ambito      String
  descrizione String?
  /// Usato quando il documento non ne indica uno proprio.
  predefinito Boolean   @default(false)
  /// Blocchi in ordine di stampa, con la loro configurazione.
  blocchi     Json      @default("[]")
  /// Margini, colore d'accento e dimensioni del testo.
  stile       Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eliminataIl DateTime?

  preventivi Preventivo[]
  contratti  Contratto[]

  @@index([ambito, predefinito])
  @@index([eliminataIl])
}

/// Testo standard riutilizzabile nei documenti (clausole di pagamento,
/// premesse, condizioni di fornitura).
///
/// Sono modelli, non testi fissi: al momento della creazione vengono copiati
/// nel documento, che resta poi indipendente. Modificare un modello non
/// riscrive i documenti già emessi.
model TestoStandard {
  id          String    @id @default(cuid())
  /// Dove si applica: PREVENTIVO, CONTRATTO o ENTRAMBI.
  ambito      String    @default("ENTRAMBI")
  /// Quale campo del documento riempie: premessa, pagamento, consegna...
  campo       String
  titolo      String
  testo       String
  /// Usato automaticamente per i nuovi documenti di questo ambito e campo.
  predefinito Boolean   @default(false)
  ordine      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eliminataIl DateTime?

  @@index([ambito, campo])
  @@index([eliminataIl])
}

/// Riga singola di configurazione dello studio + stato integrazione Twenty.
///
/// I dati anagrafici dell'emittente (ragione sociale, P.IVA...) non sono
/// più qui: sono su Azienda, perché uno studio può fatturare da più
/// ragioni sociali. Questo modello resta per le preferenze che invece sono
/// uniche per tutto lo studio.
model Impostazioni {
  id                  Int               @id @default(1)
  /// Nome dello spazio di lavoro: sidebar e titolo delle pagine. Non è un
  /// dato fiscale — a differenza della ragione sociale, resta lo stesso
  /// anche cambiando quale Azienda è predefinita per la fatturazione.
  nomeSpazio          String            @default("Telaio")
  /// Iniziale mostrata nel riquadro colorato della sidebar. Se vuota si usa
  /// la prima lettera di nomeSpazio.
  inizialeSpazio      String?
  tariffaListino      Decimal           @default(65) @db.Decimal(10, 2)
  terminiPagamento    Int               @default(30)
  twentyWorkspace     String?
  twentySyncedAt      DateTime?
  twentyFrequenza     Int               @default(15) // minuti
  /// Come si calcolano le trasferte per impostazione predefinita.
  modalitaTrasferta   ModalitaTrasferta @default(CHILOMETRICA)
  /// Tariffa al chilometro, usata dalla modalità chilometrica.
  tariffaChilometrica Decimal           @default(0.50) @db.Decimal(10, 2)
  /// Importo fisso per uscita, usato dalla modalità forfettaria.
  forfaitTrasferta    Decimal           @default(30) @db.Decimal(10, 2)
  /// Soglia oltre la quale va applicata la marca da bollo (documenti esenti IVA).
  sogliaBollo         Decimal           @default(77.47) @db.Decimal(10, 2)
  /// Importo della marca da bollo.
  importoBollo        Decimal           @default(2) @db.Decimal(10, 2)
  updatedAt           DateTime          @updatedAt
}

/// Una ragione sociale da cui lo studio può emettere documenti.
///
/// Più di una riga è normale: chi ha uno studio associato o più partite
/// IVA vuole scegliere, documento per documento, chi sta fatturando.
/// Ogni campo anagrafico è facoltativo: uno vuoto non appare nel PDF invece
/// di stampare un'etichetta senza valore.
model Azienda {
  id             String   @id @default(cuid())
  ragioneSociale String
  partitaIva     String?
  codiceFiscale  String?
  iban           String?
  /// Es. "Regime forfettario", "Regime ordinario". Libero perché le diciture
  /// fiscali corrette cambiano da caso a caso e non vanno indovinate.
  regimeFiscale  String?
  indirizzo      String?
  citta          String?
  cap            String?
  provincia      String?
  telefono       String?
  email          String?
  pec            String?
  sitoWeb        String?
  /// Chiave dell'oggetto su S3/MinIO, come per i documenti allegati.
  logoChiave     String?
  /// Predefinita per i nuovi documenti; le altre restano selezionabili a mano.
  predefinita    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preventivi Preventivo[]
  contratti  Contratto[]
  fatture    Fattura[]
}

// ---------------------------------------------------------------- accessi

/// Utente dello studio. Non c'è registrazione aperta: gli account si creano
/// con `npm run utenti:crea` (vedi scripts/utente.mjs).
model Utente {
  id            String    @id @default(cuid())
  email         String    @unique
  nome          String
  passwordHash  String
  attivo        Boolean   @default(true)
  ultimoAccesso DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

/// Chiave per l'accesso programmatico (oggi: il server MCP).
///
/// La chiave vera si mostra una sola volta, alla creazione: qui resta solo
/// il suo hash, come per le password. Revocare non cancella la riga, così
/// resta uno storico di chi ha avuto accesso e quando.
model ApiKey {
  id          String    @id @default(cuid())
  nome        String
  /// SHA-256 della chiave: basta per verificarla, non serve poterla rileggere.
  hash        String    @unique
  /// Ultimi caratteri della chiave, per riconoscerla nell'elenco senza rivelarla.
  suffisso    String
  scadeIl     DateTime?
  ultimoUsoIl DateTime?
  revocataIl  DateTime?
  createdAt   DateTime  @default(now())

  @@index([hash])
}

/// Notifica in uscita verso un sistema esterno, come le API integrations
/// di Twenty: quando succede un evento a cui il webhook è iscritto, Telaio
/// invia una POST con il payload, firmata con il secret così chi riceve può
/// verificarne l'origine.
model Webhook {
  id          String    @id @default(cuid())
  nome        String
  url         String
  /// Eventi a cui è iscritto, es. "preventivo.accettato". "*" per tutti.
  eventi      String[]
  /// Usato per firmare il payload (header X-Telaio-Signature, HMAC-SHA256).
  secret      String
  attivo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  eliminataIl DateTime?

  consegne RegistroWebhook[]

  @@index([attivo])
  @@index([eliminataIl])
}

/// Esito di un tentativo di consegna: serve a capire se un webhook sta
/// davvero funzionando o se l'endpoint remoto è irraggiungibile da tempo.
model RegistroWebhook {
  id         String   @id @default(cuid())
  webhookId  String
  evento     String
  /// Payload inviato, per poterlo rivedere in caso di problemi.
  payload    Json
  successo   Boolean
  statusHttp Int?
  errore     String?
  inviataIl  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, inviataIl])
}
