# Variabili di produzione di Telaio. Sul VPS: /opt/telaio/.env.production (permessi 600, mai in git).
# Copia questo file, sostituisci ogni "CAMBIA-…" e non committare il risultato.
# Genera i segreti con:  openssl rand -hex 32

# ── Applicazione ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Indirizzo pubblico: da qui derivano cookie, passkey (rpID = hostname) e origini consentite.
# Se cambia il dominio, le passkey già registrate non valgono più.
BETTER_AUTH_URL=https://telaio.mattiacapelli.it
# Firma i cookie e cifra i segreti 2FA: se lo perdi, la 2FA non è più utilizzabile. Va nel backup.
BETTER_AUTH_SECRET=CAMBIA-openssl-rand-hex-32
# Codice per la prima configurazione guidata (https://…/setup). In produzione il wizard non parte senza:
# chi arriva per primo su un server pubblico potrebbe altrimenti inizializzarlo al posto tuo.
# Almeno 16 caratteri. Dopo il setup puoi toglierlo.
SETUP_TOKEN=CAMBIA-openssl-rand-hex-16

# ── Database e Redis ──────────────────────────────────────────────────────────────────────────
# Usa password esadecimali (openssl rand -hex 24): finiscono dentro un URL, niente caratteri speciali.
POSTGRES_PASSWORD=CAMBIA-openssl-rand-hex-24
REDIS_PASSWORD=CAMBIA-openssl-rand-hex-24
# Costruiti dalle password sopra: dentro la rete Docker gli host sono "postgres" e "redis".
DATABASE_URL=postgres://telaio:${POSTGRES_PASSWORD}@postgres:5432/telaio
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Integrazioni (opzionali) ──────────────────────────────────────────────────────────────────
# Twenty CRM: se vuote, in produzione l'elenco clienti resta vuoto (i clienti di esempio esistono solo in sviluppo).
TWENTY_API_URL=
TWENTY_API_KEY=
# Email per i solleciti: un provider SMTP reale (non esiste Mailpit in produzione).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true solo per la porta 465 (TLS implicito); con 587 si usa STARTTLS e resta false.
SMTP_SECURE=false
SMTP_FROM=Telaio <noreply@mattiacapelli.it>
# Archivio dei documenti dei progetti (S3 o compatibile). Si configura da Impostazioni → Archiviazione
# (le chiavi si salvano cifrate); qui un valore di ripiego, opzionale.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# ── Docker ────────────────────────────────────────────────────────────────────────────────────
# Registro delle immagini. La versione (SHA del commit) la imposta il deploy, non scriverla qui.
TELAIO_REGISTRY=ghcr.io/mattiacapelli
# Porta locale del web (solo 127.0.0.1). Controlla che sia libera: ss -ltnp | grep :3100
WEB_PORT=3100
# Limiti di risorse (opzionali, valori predefiniti sotto)
# POSTGRES_MEM_LIMIT=1g
# POSTGRES_CPUS=1.0
# REDIS_MEM_LIMIT=256m
# REDIS_CPUS=0.5
# WEB_MEM_LIMIT=768m
# WEB_CPUS=1.0
# WORKER_MEM_LIMIT=512m
# WORKER_CPUS=0.5
# Copie locali tenute dal job notturno del worker (nel volume Docker). Non sostituiscono il backup offsite.
# WORKER_BACKUP_KEEP=7

# ── Backup sul server (deploy/backup.sh) ──────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/telaio
BACKUP_KEEP_DAYS=14
# Offsite, almeno uno dei due. rclone: "nome-remoto:cartella" (B2, S3, Hetzner…). rsync: "utente@host:/percorso/"
BACKUP_RCLONE_REMOTE=
BACKUP_RSYNC_TARGET=
# Chiave pubblica age: i backup vengono cifrati prima di lasciare il VPS (contengono dati contabili).
BACKUP_AGE_RECIPIENT=
