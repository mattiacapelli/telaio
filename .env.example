# Database e code
DATABASE_URL=postgres://telaio:telaio@localhost:5433/telaio
REDIS_URL=redis://localhost:6380

# Auth (Better Auth). Genera il segreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-questo-segreto-di-sviluppo-32-caratteri
BETTER_AUTH_URL=http://localhost:3000

# Utente creato dal seed
SEED_ADMIN_EMAIL=mattia@telaio.local
SEED_ADMIN_PASSWORD=telaio-dev-2026
SEED_ADMIN_NAME=Mattia

# Twenty CRM (se vuoti, /clienti usa dati finti)
TWENTY_API_URL=
TWENTY_API_KEY=

# Email (Mailpit in sviluppo)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM=Telaio <noreply@telaio.local>
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Archivio documenti (S3 / MinIO). Si configura da Impostazioni → Archiviazione; queste variabili
