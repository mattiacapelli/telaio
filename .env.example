# Database (docker compose fornisce questi valori di default)
POSTGRES_USER=telaio
POSTGRES_PASSWORD=telaio
POSTGRES_DB=telaio
POSTGRES_PORT=5433
DATABASE_URL="postgresql://telaio:telaio@localhost:5433/telaio?schema=public"

# Redis
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380"

# App
APP_PORT=3000

# Twenty CRM — API key da Impostazioni › API & Webhooks nel workspace Twenty.
# Per un'istanza self-hosted usa il tuo dominio, senza /rest e senza slash
# finale: il client aggiunge da sé il percorso (es. https://crm.esempio.it).
TWENTY_API_URL="https://api.twenty.com"
TWENTY_API_KEY=""

# MinIO — storage dei documenti allegati ai progetti
MINIO_USER=telaio
MINIO_PASSWORD=telaio-secret
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
S3_ENDPOINT="http://localhost:9002"
S3_BUCKET=telaio
S3_ACCESS_KEY=telaio
S3_SECRET_KEY=telaio-secret

# GitHub — collegamento facoltativo delle repository ai progetti.
# Token personale con permesso di lettura sui repository (classic: scope `repo`).
GITHUB_TOKEN=""

# SMTP — invio email dai workflow (facoltativo)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Telaio <noreply@studioferrero.it>"

# Scheduler — attività ricorrenti (scadenze contratti, rinnovi, workflow a tempo).
# Senza token il processo non parte: generane uno con `openssl rand -hex 32`.
SCHEDULER_TOKEN=""
SCHEDULER_INTERVALLO=3600

# Server MCP — accesso ai dati di Telaio per un assistente AI (Claude e simili).
# Endpoint: POST /api/mcp con header "Authorization: Bearer <MCP_TOKEN>".
# Senza token l'endpoint rifiuta ogni richiesta. Generane uno con `openssl rand -hex 32`.
MCP_TOKEN=""

# Licenze crittografiche — cifra a riposo la chiave privata MASTER di ogni
# prodotto in modalità offline (AES-256-GCM). Genera con `openssl rand -hex 32`.
# Senza questa variabile non è possibile generare una nuova chiave master:
# l'operazione fallisce esplicitamente invece di salvare la privata in chiaro.
LICENSE_ENCRYPTION_KEY=""

# Seed iniziale — crea l'unico utente di accesso al primo avvio (gira una
# sola volta: se esiste già un utente il seed non fa nulla). SEED_PASSWORD è
# obbligatoria, apposta senza default nel repo: il seed si rifiuta di
# eseguire senza. Cambia le altre a piacere.
SEED_EMAIL="admin@localhost"
SEED_NOME="Amministratore"
SEED_PASSWORD=""
SEED_NOME_SPAZIO="Telaio"
